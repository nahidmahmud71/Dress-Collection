<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="850.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shop.dresscollection.DressListController">
    <children>
        <Label layoutX="320.0" layoutY="20.0" text="Dress Collection" textFill="#7671bd">
            <font>
                <Font name="System Bold Italic" size="26.0" />
            </font>
        </Label>
        <Button layoutX="760.0" layoutY="25.0" mnemonicParsing="false" onAction="#backAction" text="Back" />

        <TextField fx:id="searchField" layoutX="30.0" layoutY="70.0" onKeyPressed="#searchOnEnter" prefWidth="300.0" promptText="Type and enter to search...." />

        <TableView fx:id="dressTable" layoutX="30.0" layoutY="110.0" prefHeight="500.0" prefWidth="350.0">
            <columns>
                <TableColumn fx:id="nameCol" prefWidth="100.0" text="Name" />
                <TableColumn fx:id="typeCol" prefWidth="80.0" text="Type" />
                <TableColumn fx:id="colorCol" prefWidth="80.0" text="Color" />
                <TableColumn fx:id="priceCol" prefWidth="90.0" text="Price" />
            </columns>
        </TableView>

        <VBox layoutX="410.0" layoutY="110.0" spacing="12.0">
            <children>
                <Label text="Selected Dress Information / Last Entried Product Information (Default))" textFill="#5b5b5b">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>
                <Label fx:id="dName" text="Dress Name: " />
                <Label fx:id="dType" text="Dress Type: " />
                <Label fx:id="dSize" text="Available Size: " />
                <Label fx:id="dColor" text="Dress Color: " />
                <Label fx:id="dPrice" text="Price: " />
                <Label fx:id="dDetails" text="Dress Details: " />
                <Label fx:id="dDate" text="Last Purchase Date: " />
                <Label fx:id="dQty" text="Available Quantity: " />
                <Label text="If less than 10 then red color" textFill="RED">
                    <font>
                        <Font size="10.0" />
                    </font>
                </Label>

                <HBox spacing="10.0">
                    <children>
                        <Label fx:id="codeTitleLabel" text="Discount Code: " />
                        <Label fx:id="dCodeLabel" text="********" />
                        <Button fx:id="toggleCodeBtn" mnemonicParsing="false" onAction="#toggleCodeAction" text="Show" />
                    </children>
                </HBox>

                <Label fx:id="dTarget" text="Targated Customer: " />
                <Label fx:id="dBoost" text="Facebok Boosting: " />

                <HBox spacing="20.0" style="-fx-padding: 10 0 0 0;">
                    <children>
                        <Button fx:id="editBtn" mnemonicParsing="false" onAction="#editAction" text="Edit" />
                        <Button fx:id="deleteBtn" mnemonicParsing="false" text="Delete" />
                    </children>
                </HBox>
                <Label text="With Confirmation Alert" textFill="#5b5b5b">
                    <font>
                        <Font size="10.0" />
                    </font>
                </Label>
            </children>
        </VBox>
    </children>
</AnchorPane>